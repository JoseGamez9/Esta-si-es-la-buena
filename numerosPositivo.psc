Algoritmo numerosPositivo
	definir num Como Entero
	Escribir "ingrese numero a evaluar: "
	leer num;
	si num > 0 Entonces
		Escribir "El numero ingresado es positivo y es:", num , ;
	FinSi
	si num < 0 Entonces
		Escribir "El numero ingresado es negativo y es:", num , ;
	FinSi
	Escribir "fin del programa";
FinAlgoritmo
