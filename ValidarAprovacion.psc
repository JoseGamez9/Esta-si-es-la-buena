Algoritmo ValidarAprovacion 
	definir nota Como Real
	Escribir "ingrese la calificacion final obtenuda (0.0 - 5.0)";
	leer nota;
	si nota >= 3.0 Entonces
		escribir "FELICIDADES: ha aprobado satisfactoriamente la asignatura" 
	FinSi
	si nota < 3.0 Entonces
		escribir "yaper papi: ha reprobado la asignatura "
	FinSi
	Escribir "Proceso de reporte de calificaciones finalizado" 
FinAlgoritmo
